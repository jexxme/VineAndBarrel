---
// One page per Vine & Barrel item, generated from src/data/gen. Stable URL: /items/<item id path>/
import ItemPage from '../../components/items/ItemPage.astro';
import { itemList, type Item } from '../../lib/data';
export function getStaticPaths() {
	return itemList.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: Item };
---
<ItemPage item={item} />
