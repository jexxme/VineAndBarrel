---
// Inline item: icon + name, linked to the page that explains it. <Item id="red_wine" />
// Farmer's Delight items show as text and link to the FD Neoforged wiki (its textures aren't redistributed here).
import { nameOf as nameIn, iconOf, pageOf, fullId, isFd } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
interface Props {
	id: string;
	count?: number;
	label?: string;
	plural?: boolean;
}
const { id: raw, count, label, plural } = Astro.props;
const id = fullId(raw);
const locale = localeOf(Astro.currentLocale);
const nameOf = (i: string) => nameIn(i, locale);
const ic = iconOf(id);
const href = pageOf(id, locale);
let text = label ?? nameOf(id);
if (plural && locale === 'en' && !label && !/s$/.test(text)) text += 's';
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['fd-item', { ext: isFd(id) && href }]} href={href ?? undefined} data-tip-items={`${nameOf(id)}~${id}`} data-tip-sub={isFd(id) && href ? t("On the Farmer's Delight Neoforged wiki", locale) : undefined}>{ic && <img src={ic.src} alt="" width="20" height="20" loading="lazy" />}{count ? `${count}× ` : ''}{text}</Tag>
