---
// A short in-game loop, full width with a caption, like <Shot>. <Clip src="kettle-fill" caption="…" />
// Files: public/clips/<src>.webm + .mp4 (no audio) and the poster src/assets/clips/<src>.jpg, listed in
// src/data/clips.json (see site/README.md). Muted and looping; it plays only while on screen, and a button (or a click
// on the clip) pauses it for good. With reduced motion it waits on the poster until played. Without JS it is a plain
// video with the browser's controls.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import clips from '../../data/clips.json';
import { url } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
interface Props {
	src: string;
	caption?: string;
	/** What the clip shows, when the caption doesn't say it (the caption names the video otherwise) */
	alt?: string;
}
const { src, caption, alt } = Astro.props;
const clip = (clips as Record<string, { width: number; height: number }>)[src];
const posters = import.meta.glob<{ default: ImageMetadata }>('../../assets/clips/*.jpg', { eager: true });
const poster = posters[`../../assets/clips/${src}.jpg`]?.default;
if (!clip || !poster) throw new Error(`Unknown clip ${src} (src/data/clips.json + src/assets/clips/${src}.jpg)`);
const still = await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1280) });
const locale = localeOf(Astro.currentLocale);
---
<figure class="fd-shot fd-clip">
	<div class="frame">
		<video
			muted
			loop
			playsinline
			controls
			disablepictureinpicture
			preload="none"
			poster={still.src}
			width={clip.width}
			height={clip.height}
			aria-label={alt}
			data-clip
		>
			<source src={url(`/clips/${src}.webm`)} type="video/webm" />
			<source src={url(`/clips/${src}.mp4`)} type="video/mp4" />
		</video>
		<button type="button" class="toggle" hidden data-play={t('Play', locale)} data-pause={t('Pause', locale)}>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pause" d="M4 3h3v10H4zM9 3h3v10H9z" /><path class="i-play" d="M5 3l8 5-8 5z" /></svg>
		</button>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
	// Every clip: our own play/pause button instead of the native controls (they stay without JS). A clip plays while
	// it's on screen, unless the reader paused it or asked for reduced motion; then only the button (or a click) plays it.
	const still = matchMedia('(prefers-reduced-motion: reduce)');
	type Clip = { video: HTMLVideoElement; button: HTMLButtonElement; visible: boolean; userPaused: boolean };
	const clips = new Map<Element, Clip>();
	const show = (c: Clip) => {
		const playing = !c.video.paused;
		c.button.classList.toggle('playing', playing);
		c.button.setAttribute('aria-label', (playing ? c.button.dataset.pause : c.button.dataset.play) ?? '');
	};
	const update = (c: Clip) => {
		if (c.visible && !c.userPaused && !still.matches) c.video.play().catch(() => {});
		else c.video.pause();
	};
	const toggle = (c: Clip) => {
		if (c.video.paused) {
			c.userPaused = false;
			c.video.play().catch(() => {});
		} else {
			c.userPaused = true;
			c.video.pause();
		}
	};
	const seen = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				const c = clips.get(e.target);
				if (!c) continue;
				c.visible = e.isIntersecting;
				update(c);
			}
		},
		{ threshold: 0.4 },
	);
	for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-clip]')) {
		const button = video.parentElement!.querySelector<HTMLButtonElement>('button.toggle')!;
		const c: Clip = { video, button, visible: false, userPaused: false };
		video.controls = false;
		button.hidden = false;
		clips.set(video, c);
		show(c);
		video.addEventListener('play', () => show(c));
		video.addEventListener('pause', () => show(c));
		video.addEventListener('click', () => toggle(c));
		button.addEventListener('click', () => toggle(c));
		seen.observe(video);
	}
	still.addEventListener('change', () => clips.forEach(update));
</script>
<style>
	.fd-shot {
		margin: 1.5rem 0;
	}
	.frame {
		position: relative;
	}
	video {
		width: 100%;
		height: auto;
		display: block;
		background: var(--sl-color-gray-6);
		cursor: pointer;
	}
	.toggle {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid rgb(255 255 255 / 0.35);
		background: rgb(0 0 0 / 0.55);
		color: #fff;
		cursor: pointer;
	}
	.toggle[hidden] {
		display: none;
	}
	.toggle:hover {
		background: rgb(0 0 0 / 0.75);
	}
	.toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.toggle svg {
		width: 1rem;
		height: 1rem;
		fill: currentColor;
	}
	.toggle .i-pause,
	.toggle.playing .i-play {
		display: none;
	}
	.toggle.playing .i-pause {
		display: inline;
	}
	figcaption {
		font-family: var(--fd-font-mono);
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
