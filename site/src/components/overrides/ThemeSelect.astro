---
// Theme switch as one square icon button (like the GitHub button next to it) instead of a dropdown.
// Uses Starlight's own storage key, so its early theme script (no flash on load) keeps working.
import { Icon } from '@astrojs/starlight/components';
import { t, localeOf } from '../../lib/i18n';

const locale = localeOf(Astro.currentLocale);
// The words for the client script (it can't call t()); {state} is filled there
const words = {
	dark: t('Dark', locale),
	light: t('Light', locale),
	auto: t('Auto (follows your system)', locale),
	title: t('Theme: {state}', locale, { state: '{state}' }),
	label: t('Colour theme: {state}. Click to change.', locale, { state: '{state}' }),
};
---
<fd-theme data-i18n={JSON.stringify(words)}>
	<button type="button" aria-label={t('Colour theme', locale)} title={t('Theme', locale)}>
		<Icon name="moon" class="i-dark" />
		<Icon name="sun" class="i-light" />
		<Icon name="laptop" class="i-auto" />
	</button>
</fd-theme>

<script>
	const KEY = 'starlight-theme';
	const stored = () => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'dark' || v === 'light' ? v : '';
		} catch {
			return '';
		}
	};
	const light = matchMedia('(prefers-color-scheme: light)');
	const apply = (pref: string) => {
		document.documentElement.dataset.theme = pref || (light.matches ? 'light' : 'dark');
		try {
			localStorage.setItem(KEY, pref);
		} catch {}
		for (const el of document.querySelectorAll<HTMLElement>('fd-theme')) {
			el.dataset.pref = pref || 'auto';
			const b = el.querySelector('button')!;
			const w = JSON.parse(el.dataset.i18n ?? '{}');
			const state = pref === 'dark' ? w.dark : pref === 'light' ? w.light : w.auto;
			b.title = w.title.replace('{state}', state);
			b.setAttribute('aria-label', w.label.replace('{state}', state));
		}
	};
	customElements.define(
		'fd-theme',
		class extends HTMLElement {
			connectedCallback() {
				// Auto -> the opposite of what you see now -> the other one -> Auto, so the first click always changes something
				this.querySelector('button')!.addEventListener('click', () => {
					const sys = light.matches ? 'light' : 'dark';
					const opp = sys === 'dark' ? 'light' : 'dark';
					const p = stored();
					apply(p === '' ? opp : p === opp ? sys : '');
				});
			}
		},
	);
	apply(stored());
	light.addEventListener('change', () => stored() === '' && apply(''));
</script>

<style>
	fd-theme button {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		padding: 0;
		background: #000;
		border: 2px solid #a0a0a0;
		border-radius: 0;
		color: #fff;
		cursor: pointer;
	}
	fd-theme button:hover {
		border-color: #fff;
	}
	fd-theme :global(svg) {
		display: none;
		width: 24px;
		height: 24px;
	}
	fd-theme[data-pref='dark'] :global(.i-dark),
	fd-theme[data-pref='light'] :global(.i-light),
	fd-theme[data-pref='auto'] :global(.i-auto),
	fd-theme:not([data-pref]) :global(.i-auto) {
		display: block;
	}
</style>
