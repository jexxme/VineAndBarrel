---
// One recipe, drawn like the game shows it. Brewing uses Vine & Barrel's own kettle screen texture at the JEI slot
// positions (compat/jei/BrewingCategory: the screen from 29,16, 116 x 56); the other types use the same visual language.
import Slot from '../mc/Slot.astro';
import Sprite from '../mc/Sprite.astro';
import { recipe as recipeOf, seconds, days, url, rules, nameOf, type Recipe } from '../../lib/data';
import { t, localeOf, listOf } from '../../lib/i18n';
interface Props {
	id?: string;
	recipe?: Recipe;
	caption?: boolean;
	scale?: number;
}
const { id, caption = true, scale: s = 2 } = Astro.props;
const r: Recipe = Astro.props.recipe ?? recipeOf(id!);
const locale = localeOf(Astro.currentLocale);
const orList = (xs: string[]) => (locale === 'en' ? xs.join(' or ') : listOf(xs, locale, 'disjunction'));
const px = (n: number) => `${n * s}px`;
const at = (x: number, y: number) => `position:absolute;left:${px(x)};top:${px(y)}`;
const type = r.type;
const xp = r.experience ?? 0;
const grid = r.grid ?? (r.ingredients && type.startsWith('crafting') ? [r.ingredients.slice(0, 3), r.ingredients.slice(3, 6), r.ingredients.slice(6, 9)] : null);
const arrow = `width:${px(24)};height:${px(16)};background-image:url(${url('/gui/mc/burn_progress.png')});background-size:100% 100%;image-rendering:pixelated;display:block`;
const KIND: Record<string, () => string> = {
	crafting_shaped: () => t('Crafting', locale),
	crafting_shapeless: () => t('Crafting (shapeless)', locale),
	'vineandbarrel:brewing': () => t('Brew Kettle', locale),
	'vineandbarrel:aging': () => t('Aging Barrel', locale),
	'farmersdelight:cooking': () => t("Farmer's Delight Cooking Pot", locale),
	'farmersdelight:cutting': () => t("Farmer's Delight Cutting Board", locale),
};
// Tag labels ("Any copper") come from the data; scripts/i18n.mjs lists them as UI strings
const tr = t;
---
<figure class="fd-recipe not-content" data-type={type} title={r.id}>
	{
		type === 'vineandbarrel:brewing' && (
			<div class="stage" style={`width:${px(116)};height:${px(56)}`}>
				<Sprite src="/gui/brew_kettle.png" x={29} y={16} w={116} h={56} scale={s} />
				{r.ingredients!.map((ing, i) => (
					<div style={at((i % 3) * 18 + 1, Math.floor(i / 3) * 18 + 1)}>
						<Slot ingredient={ing} bare scale={s} />
					</div>
				))}
				<div style={at(60, 9)}>
					<Sprite src="/gui/brew_kettle.png" x={176} y={15} w={24} h={17} scale={s} class="fd-arrow" />
				</div>
				<div style={at(18, 39)} data-tip-items={`${t('Needs heat from below', locale)}~`} tabindex="0">
					<Sprite src="/gui/brew_kettle.png" x={176} y={0} w={17} h={15} scale={s} />
				</div>
				<div style={at(64, 2)}>
					<Sprite src="/gui/brew_kettle.png" x={176} y={32} w={8} h={11} scale={s} />
				</div>
				{xp > 0 && (
					<div style={at(63, 21)}>
						<Sprite src="/gui/brew_kettle.png" x={176} y={43} w={9} h={9} scale={s} />
					</div>
				)}
				<div class="hit" style={`${at(61, 2)};width:${px(22)};height:${px(28)}`} data-tip-items={`${t('Brewing time: {time}', locale, { time: seconds(r.brewingTime!, locale) })}~`} data-tip-sub={xp > 0 ? t('{value} XP', locale, { value: +xp.toFixed(2) }) : undefined} tabindex="0" />
				<div style={at(95, 10)}>
					<Slot id={r.result!.id} count={r.servings} bare scale={s} note={t('{n} serving|{n} servings', locale, { n: r.servings! })} />
				</div>
				<div style={at(63, 39)}>
					<Slot ingredient={{ items: ['minecraft:glass_bottle', 'minecraft:bucket'] }} bare scale={s} note={t('A bottle takes {bottle} serving, a bucket {bucket}', locale, { bottle: rules.servingsPerBottle, bucket: rules.servingsPerBucket })} />
				</div>
				<div style={at(95, 39)}>
					<Slot ingredient={{ items: [r.result!.id, r.bucket!.id] }} bare scale={s} />
				</div>
			</div>
		)
	}
	{
		type === 'vineandbarrel:aging' && (
			<div class="mc-panel row" style={`--s:${s}px`}>
				<Slot ingredient={{ items: [r.base!.id, ...(r.bucket ? [r.bucket.id] : [])] }} scale={s} />
				<div class="col step">
					<span style={arrow} />
					<span class="mc-label">{days(r.fermentingTime!, locale)}</span>
				</div>
				<Slot id={r.young!.id} large scale={s} note={t('Young', locale)} />
				<div class="col step">
					<span style={arrow} />
					<span class="mc-label">+{days(r.agingTime!, locale)}</span>
				</div>
				<Slot id={r.aged!.id} large scale={s} note={t('Aged', locale)} />
			</div>
		)
	}
	{
		grid && (
			<div class="mc-panel row" style={`--s:${s}px`}>
				<div class="grid3">
					{[0, 1, 2].map((y) => [0, 1, 2].map((x) => <Slot ingredient={grid[y]?.[x] ?? null} scale={s} />))}
				</div>
				<span style={arrow} />
				<Slot id={r.result!.id} count={r.result!.count} large scale={s} />
			</div>
		)
	}
	{
		type === 'farmersdelight:cooking' && (
			<div class="mc-panel row" style={`--s:${s}px`}>
				<div class="grid3">
					{r.ingredients!.map((ing) => <Slot ingredient={ing} scale={s} />)}
				</div>
				<div class="col">
					<span style={arrow} />
					<span class="mc-label">{seconds(r.cookingtime!, locale)}</span>
				</div>
				<Slot id={r.result!.id} large scale={s} />
				{r.container && <Slot id={r.container.id} scale={s} note={t('Served in', locale)} />}
			</div>
		)
	}
	{
		type === 'farmersdelight:cutting' && (
			<div class="mc-panel row" style={`--s:${s}px`}>
				<Slot ingredient={r.ingredients![0]} scale={s} />
				<Slot ingredient={r.tool!} scale={s} note={t('Cut with', locale)} />
				<span style={arrow} />
				{r.results!.map((x) => <Slot id={x.id} count={x.count} chance={x.chance < 1 ? x.chance : undefined} scale={s} />)}
			</div>
		)
	}
	{
		caption && (
			<figcaption>
				<span class="kind">{KIND[type]?.() ?? type}</span>
				{r.brewingTime && <span class="stat">{seconds(r.brewingTime, locale)}</span>}
				{r.servings && <span class="stat">{t('{n} serving|{n} servings', locale, { n: r.servings })}</span>}
				{xp > 0 && <span class="stat xp">{t('{value} xp', locale, { value: +xp.toFixed(2) })}</span>}
				{r.fdOnly && <span class="hint">{t("needs Farmer's Delight", locale)}</span>}
				{type === 'farmersdelight:cooking' && (
					<span class="hint">{t('Ingredients: {list}', locale, { list: r.ingredients!.map((i) => (i.label ? tr(i.label, locale) : null) ?? orList(i.items.map((x) => nameOf(x, locale)))).join(', ') })}</span>
				)}
			</figcaption>
		)
	}
</figure>

<style>
	.fd-recipe {
		display: inline-flex;
		flex-direction: column;
		gap: 0.35rem;
		margin: 0;
		vertical-align: top;
		max-width: 100%;
	}
	/* The JEI texture sits on a GUI panel, like JEI's own recipe screen: grey frame, bevel, black outline */
	.stage {
		position: relative;
		margin: 10px;
		box-shadow:
			0 0 0 8px #c6c6c6,
			-2px -2px 0 8px #fff,
			2px 2px 0 8px #555,
			0 0 0 10px #000;
	}
	.fd-recipe:has(.stage) figcaption {
		margin-top: 8px;
	}
	.row {
		display: flex !important;
		align-items: center;
		gap: calc(6 * var(--s));
		flex-wrap: wrap;
	}
	.grid3 {
		display: grid;
		grid-template-columns: repeat(3, auto);
	}
	.col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(2 * var(--s));
	}
	.flame {
		display: block;
		image-rendering: pixelated;
	}
	.stations {
		display: flex;
		gap: 2px;
		margin-left: calc(2 * var(--s));
		padding-left: calc(4 * var(--s));
		border-left: 2px solid #8b8b8b;
	}
	.step {
		gap: calc(2 * var(--s));
	}
	.mc-label {
		font-family: var(--fd-font-pixel);
		font-size: 20px;
		color: #404040;
		white-space: nowrap;
		line-height: 1;
	}
	.mc-label.xp {
		color: #3f8a00;
	}
	.special {
		font-family: var(--fd-font-pixel);
		padding: 1rem;
	}
	figcaption {
		font-family: var(--fd-font-mono);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		max-width: 18rem;
	}
	figcaption .stat {
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-2);
	}
	figcaption .xp {
		color: var(--fd-green);
	}
	figcaption .kind {
		font-weight: 500;
		color: var(--sl-color-gray-2);
	}
	figcaption code {
		font-size: 0.95em;
		padding: 0;
		background: none;
		color: var(--sl-color-gray-4);
	}
	/* The arrow fills left to right over 10 s, pixel by pixel, like JEI's animated arrow (200 ticks) */
	:global(.fd-arrow) {
		animation: fd-cook 10s steps(24, end) infinite;
	}
	@keyframes fd-cook {
		from {
			width: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.fd-arrow) {
			animation: none;
		}
	}
	.hit {
		cursor: help;
	}
</style>
