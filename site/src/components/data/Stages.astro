---
// A strip of isometric renders, one per state (growth age, bung, weathering...). Renders come from
// scripts/render-scenes.mjs (public/renders/stages/<prefix>-<n>.png). Swipe it on a phone; "Play" steps through the
// states one after another, like watching the block change.
import { renders, url } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
interface Props {
	prefix: string;
	title: string;
	labels?: string[];
	only?: string[];
}
const { prefix, title, labels = [], only } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const keys = Object.keys(renders)
	.filter((k) => k.startsWith(`stages/${prefix}-`) && (!only || only.includes(k.split('-').pop()!)))
	.sort((a, b) => +a.split('-').pop()! - +b.split('-').pop()!);
if (keys.length < 2) throw new Error(`No stage renders for ${prefix}`);
---
<figure class="fd-stages not-content">
	<figcaption>
		<span class="fd-kicker">{title}</span>
		<button type="button" class="play" aria-pressed="false" aria-label={t('Play the {title} stages', locale, { title: title.toLowerCase() })} data-i18n={JSON.stringify({ play: t('Play', locale), stop: t('Stop', locale) })}>
			<span class="i" aria-hidden="true"></span><span class="t">{t('Play', locale)}</span>
		</button>
	</figcaption>
	<ol>
		{keys.map((k, i) => (
			<li>
				<img src={url(`/renders/${k}.png`)} alt={labels[i] ?? k.split('-').pop()} width="96" height="96" loading="lazy" />
				<span>{labels[i] ?? k.split('-').pop()}</span>
			</li>
		))}
	</ol>
</figure>
<script>
	for (const fig of document.querySelectorAll<HTMLElement>('.fd-stages')) {
		const btn = fig.querySelector<HTMLButtonElement>('.play')!;
		const words = JSON.parse(btn.dataset.i18n ?? '{}');
		const items = [...fig.querySelectorAll<HTMLLIElement>('li')];
		let timer = 0;
		let at = -1;
		const step = () => {
			items[at]?.classList.remove('on');
			at = (at + 1) % items.length;
			items[at].classList.add('on');
			// keep the lit stage in view when the strip scrolls (phones), without moving the page
			const ol = items[at].parentElement!;
			ol.scrollTo({ left: items[at].offsetLeft - ol.offsetLeft - 8, behavior: 'smooth' });
		};
		const stop = () => {
			clearInterval(timer);
			timer = 0;
			items[at]?.classList.remove('on');
			at = -1;
			fig.classList.remove('playing');
			btn.setAttribute('aria-pressed', 'false');
			btn.querySelector('.t')!.textContent = words.play ?? 'Play';
		};
		btn.addEventListener('click', () => {
			if (timer) return stop();
			fig.classList.add('playing');
			btn.setAttribute('aria-pressed', 'true');
			btn.querySelector('.t')!.textContent = words.stop ?? 'Stop';
			step();
			timer = window.setInterval(step, 900);
		});
		// stop when it scrolls out of sight
		new IntersectionObserver(([e]) => !e.isIntersecting && timer && stop()).observe(fig);
	}
</script>
<style>
	.fd-stages {
		padding: 0.6rem 0 0.4rem;
		margin: 1.5rem 0;
		border-top: 2px solid var(--fd-rule);
		border-bottom: 2px solid var(--fd-border);
	}
	figcaption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.play {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font: inherit;
		font-size: 20px;
		color: var(--sl-color-gray-3);
		background: none;
		border: 0;
		padding: 2px 4px;
		cursor: pointer;
	}
	.play:hover,
	.play:focus-visible {
		color: var(--sl-color-text-accent);
		outline: none;
	}
	/* a pixel play triangle / stop square */
	.play .i {
		width: 10px;
		height: 12px;
		background: currentColor;
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}
	.play[aria-pressed='true'] .i {
		clip-path: none;
		height: 10px;
	}
	ol {
		list-style: none;
		padding: 0 0 4px;
		margin: 0.5rem 0 0;
		display: flex;
		gap: 0.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
	}
	li {
		flex: 1 0 5.5rem;
		max-width: 8rem;
		margin: 0 !important;
		text-align: center;
		scroll-snap-align: start;
		position: relative;
		transition: opacity 0.2s;
	}
	/* arrows between the states */
	li + li::before {
		content: '>';
		position: absolute;
		left: -0.4rem;
		top: 2.4rem;
		color: var(--sl-color-gray-4);
	}
	img {
		width: 100%;
		height: auto;
		max-width: 96px;
		transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	li:hover img {
		transform: translateY(-4px);
	}
	span {
		display: block;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
		transition: color 0.15s;
	}
	li:hover span {
		color: var(--sl-color-white);
	}
	/* playing: the current state lifts and lights up, the others step back */
	.playing li {
		opacity: 0.45;
	}
	.playing li.on {
		opacity: 1;
	}
	.playing li.on img {
		transform: translateY(-6px) scale(1.06);
	}
	.playing li.on span {
		color: var(--sl-color-text-accent);
	}
	@media (prefers-reduced-motion: reduce) {
		img,
		.playing li.on img,
		li:hover img {
			transition: none;
			transform: none;
		}
	}
</style>
