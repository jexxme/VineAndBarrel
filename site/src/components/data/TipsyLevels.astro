---
// The Tipsy levels, from the mod: what each level adds, and a view through the player's eyes at that level. Hover a
// level (tap it on a phone) to see it; the tooltip lists what the level does in the effect tooltip's own words (exported
// by the game: blue the courage, red the drawbacks). Tipsy never moves your view on its own, so the view only jolts
// with a hiccup and lurches with a stumble; the drunk eyes soften its edges and, from double vision on, a second image
// slides apart and back; the chat comes out the way that level slurs it. Everything comes from the rules export
// (tipsy.levels: each level's row of the mod's TipsyLevels sections: legs, eyes, ears, nod, chat, rules); the view's
// motion and the chat lines are only illustrations.
import { Picture } from 'astro:assets';
import { rules, pct, roman, url, gameText } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
import Tr from '../mc/Tr.astro';
import view from '../../assets/shots/terrace.jpg';

type Level = {
	level: number;
	courage: { knockbackResistance: number; fallDamageReduction: number };
	hiccups: { boutOneIn: number; fewest: number; most: number };
	legs: { steer: number; weave: number; legsOneIn: number; tripOneIn: number; slower: number };
	eyes: { softEdges: number; doubleVision: number; signBlur: number };
	ears: { muffle: number; heartbeat: number };
	nod: { stillTicks: number };
	chat: { stage: number };
	rules: { buffs: boolean; rowdySwingOneIn: number; cutOff: boolean };
	tooltipGood: string[];
	tooltipBad: string[];
};
const locale = localeOf(Astro.currentLocale);
const tipsy = rules.tipsy;
const cfg = tipsy.config;
const levels: Level[] = tipsy.levels;
const tipsyName = gameText('effect.vineandbarrel.tipsy', 'Tipsy', locale);
const drunkWalk = (at: Level | undefined) => !!at && (at.legs.steer < 1 || at.legs.weave > 0);
const stage = (at: Level | undefined) => (cfg.slurredChat && at ? at.chat.stage : 0);
// How the chat line in the view comes out at each chat stage (0 as typed .. 4 gibberish), like the game's slur
const chatLines = [
	t('I love this song', locale),
	t('I love this song *hic*', locale),
	t('I love thish shooong *hic*', locale),
	t('I lvoe thishh *hic* shooong', locale),
	t('I blamu whish gluff *hic*', locale),
];
const rows = levels.map((at, i) => {
	const prev: Level | undefined = levels[i - 1];
	const adds: string[] = [];
	// The legs: the drunk walk from the start, stumbles and trips later, then heavy legs
	if (cfg.stumbling) {
		if (drunkWalk(at) && !drunkWalk(prev)) adds.push(t('drunk legs: your steps come a moment late and the walk curves off course, so you keep correcting', locale));
		if (at.legs.legsOneIn > 0 && !(prev?.legs.legsOneIn > 0)) adds.push(t('stumbles to the side, and now and then a trip onto your face (it never hurts)', locale));
		else if (at.legs.legsOneIn > 0 && at.legs.legsOneIn < prev.legs.legsOneIn) adds.push(t('you stumble far more often', locale));
		else if (drunkWalk(prev) && at.legs.weave > prev.legs.weave) adds.push(t('the walk weaves more', locale));
		if (at.legs.slower > 0 && !(prev?.legs.slower > 0)) adds.push(t('heavy legs: {n} slower', locale, { n: pct(at.legs.slower, 0, locale) }));
		else if (at.legs.slower > (prev?.legs.slower ?? 0)) adds.push(t('heavier legs: {n} slower', locale, { n: pct(at.legs.slower, 0, locale) }));
	}
	// The eyes: soft edges, then double vision and fading signs, stronger each level
	if (cfg.doubleVision) {
		if (at.eyes.softEdges > 0 && !(prev?.eyes.softEdges > 0)) adds.push(t('soft, slightly warm screen edges', locale));
		if (at.eyes.doubleVision > 0 && !(prev?.eyes.doubleVision > 0)) adds.push(t('double vision (hold sneak to squint)', locale));
		else if (at.eyes.doubleVision > (prev?.eyes.doubleVision ?? 0)) adds.push(t('stronger double vision', locale));
		if (at.eyes.signBlur > 0 && !(prev?.eyes.signBlur > 0)) adds.push(t('the writing on signs fades', locale));
		else if (at.eyes.signBlur >= 1 && prev && prev.eyes.signBlur < 1) adds.push(t('signs barely readable', locale));
	}
	// The ears: woolly sound, then your own heart
	if (cfg.woollySound) {
		if (at.ears.muffle > 0 && !(prev?.ears.muffle > 0)) adds.push(t('woolly sound: the world goes muffled', locale));
		else if (at.ears.muffle > (prev?.ears.muffle ?? 0)) adds.push(t('more muffled', locale));
	}
	if (at.ears.heartbeat > 0 && !(prev?.ears.heartbeat > 0)) adds.push(t('you hear your own heart', locale));
	if (at.nod.stillTicks > 0 && !(prev?.nod.stillTicks > 0) && cfg.noddingOff) adds.push(t('stand still a while and you nod off on your feet', locale));
	// Hiccups come in bouts: a few, a couple of seconds apart, then a quiet stretch
	if (at.hiccups.boutOneIn > 0 && !(prev?.hiccups.boutOneIn > 0)) adds.push(t('now and then a short bout of hiccups', locale));
	else if (at.hiccups.boutOneIn > 0 && prev && at.hiccups.boutOneIn < prev.hiccups.boutOneIn && i < levels.length - 1) adds.push(t('more hiccups', locale));
	// Chat, worse each stage
	const chat = stage(at);
	if (chat > stage(prev)) {
		const says = [
			'',
			t('the odd *hic* in chat', locale),
			t('slurred chat, still easy to read', locale),
			t('chat gets hard to read', locale),
			t('chat turns to gibberish', locale),
		];
		adds.push(says[Math.min(chat, 4)]);
	}
	const courage = at.courage;
	if (courage.knockbackResistance > 0 || courage.fallDamageReduction > 0) {
		adds.push(t('liquid courage: {kb} knockback resistance and {fall} less fall damage', locale, { kb: pct(courage.knockbackResistance, 0, locale), fall: pct(courage.fallDamageReduction, 0, locale) }));
	} else if (prev && (prev.courage.knockbackResistance > 0 || prev.courage.fallDamageReduction > 0)) {
		adds.push(t('the courage is gone', locale));
	}
	if (!at.rules.buffs && prev?.rules.buffs) adds.push(t("you're too drunk to enjoy it: drinks give no buff, and the earlier drinks' buffs go too", locale));
	if (at.rules.rowdySwingOneIn > 0 && !(prev?.rules.rowdySwingOneIn > 0) && cfg.rowdy && cfg.rowdyPunches) adds.push(t('rowdy: now and then you pick a fight with whoever is in front of you', locale));
	if (at.rules.cutOff && !prev?.rules.cutOff && cfg.rowdy && cfg.cutOff) adds.push(t("villagers and traders won't serve you", locale));
	// The effect tooltip's lines, as the game builds them (tipsy/TipsyInfo.java): three words a line
	const lines: string[] = [];
	for (let j = 0; j < at.tooltipBad.length; j += 3) lines.push(at.tooltipBad.slice(j, j + 3).join(', '));
	// What the view shows
	const flags = [
		at.hiccups.boutOneIn > 0 && 'hic',
		at.legs.legsOneIn > 0 && cfg.stumbling && 'stumble',
		at.eyes.doubleVision > 0 && cfg.doubleVision && 'double',
	].filter(Boolean);
	const eyes = cfg.doubleVision ? at.eyes : { softEdges: 0, doubleVision: 0 };
	return { lvl: at.level, adds, good: at.tooltipGood, lines, flags: flags.join(' '), say: chatLines[Math.min(chat, 4)], soft: eyes.softEdges, split: eyes.doubleVision };
});
---
<div class="vb-tipsy not-content" data-level="0" data-i18n={JSON.stringify({ sober: t('sober', locale), tipsy: tipsyName })}>
	<div class="view-wrap">
		<div class="view" aria-hidden="true">
			<div class="world">
				<Picture src={view} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 960]} sizes="(max-width: 50rem) 100vw, 30rem" alt="" class="shot" />
				<div class="ghost">
					<Picture src={view} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 960]} sizes="(max-width: 50rem) 100vw, 30rem" alt="" class="shot" />
				</div>
			</div>
			<div class="edges"></div>
			<span class="hic-txt">{t('*hic*', locale)}</span>
			<div class="hud">
				<span class="eff tipsy"><img src={url('/gui/effect/tipsy.png')} alt="" width="36" height="36" /><b></b></span>
			</div>
			<p class="chat"><span class="who">&lt;Steve&gt;</span> <span class="say" data-sober={chatLines[0]}>{chatLines[0]}</span></p>
		</div>
		<p class="view-cap fd-kicker"><Tr k="Through your eyes: {level}" locale={locale}><span slot="level" class="lvl-name">{t('sober', locale)}</span></Tr></p>
	</div>
	<div class="levels" role="radiogroup" aria-label={t('Tipsy level', locale)} data-hint={t('Hover a level, click to keep it.', locale)} data-hint-touch={t('Tap a level to look through its eyes.', locale)}>
		<button type="button" role="radio" aria-checked="true" class="pip" data-level="0" data-tip-items={`${t('Sober', locale)}~`} style="--lvl:0">
			<span>0</span>
		</button>
		{rows.map((r) => (
			<button
				type="button"
				role="radio"
				aria-checked="false"
				class="pip"
				data-level={r.lvl}
				data-flags={r.flags}
				data-say={r.say}
				data-soft={r.soft}
				data-split={r.split}
				data-tip-items={`${tipsyName} ${roman(r.lvl - 1)}~`}
				data-tip-extra={r.good.join('\n') || undefined}
				data-tip-bad={r.lines.join('\n')}
				style={`--lvl:${r.lvl}`}
			>
				<span>{r.lvl}</span>
			</button>
		))}
	</div>
	<ol class="fd-tipsy">
		{rows.map((r) => (
			<li style={`--lvl:${r.lvl}`} data-level={r.lvl}>
				<span class="lvl">{r.lvl}</span>
				<span class="what">{r.adds.map((a) => <span class="add">{a}</span>)}</span>
			</li>
		))}
	</ol>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.vb-tipsy')) {
		const view = root.querySelector<HTMLElement>('.view')!;
		const pips = [...root.querySelectorAll<HTMLButtonElement>('.pip')];
		const rows = [...root.querySelectorAll<HTMLElement>('.fd-tipsy li')];
		const say = root.querySelector<HTMLElement>('.say')!;
		const name = root.querySelector<HTMLElement>('.lvl-name')!;
		const i18n = JSON.parse(root.dataset.i18n!);
			const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
		let pinned = 0;
		const show = (lvl: number) => {
			const pip = pips[lvl];
			const flags = (pip.dataset.flags ?? '').split(' ').filter(Boolean);
			root.dataset.level = String(lvl);
			for (const c of [...view.classList]) if (c.startsWith('f-') || c === 'tipsy') view.classList.remove(c);
			for (const f of flags) view.classList.add(`f-${f}`);
			view.classList.toggle('tipsy', lvl > 0);
			for (const e of view.querySelectorAll<HTMLElement>('.hud .eff')) e.hidden = lvl === 0;
			view.querySelector('.hud .tipsy b')!.textContent = lvl ? roman[lvl - 1] : '';
			say.textContent = pip.dataset.say ?? say.dataset.sober!;
			view.style.setProperty('--soft', pip.dataset.soft ?? '0');
			view.style.setProperty('--split', pip.dataset.split ?? '0');
			name.textContent = lvl ? `${i18n.tipsy} ${roman[lvl - 1]}` : i18n.sober;
			rows.forEach((r) => r.classList.toggle('on', +r.dataset.level! === lvl));
		};
		const pin = (lvl: number, focus = false) => {
			pinned = lvl;
			pips.forEach((p, i) => {
				p.setAttribute('aria-checked', String(i === lvl));
				p.tabIndex = i === lvl ? 0 : -1;
			});
			if (focus) pips[lvl].focus();
			show(lvl);
		};
		pips.forEach((p, i) => {
			p.tabIndex = i === 0 ? 0 : -1;
			p.addEventListener('click', () => pin(i));
			p.addEventListener('pointerenter', (e) => e.pointerType !== 'touch' && show(i));
			p.addEventListener('pointerleave', (e) => e.pointerType !== 'touch' && show(pinned));
			p.addEventListener('keydown', (e) => {
				const to = ({ ArrowRight: i + 1, ArrowUp: i + 1, ArrowLeft: i - 1, ArrowDown: i - 1, Home: 0, End: pips.length - 1 } as Record<string, number>)[e.key];
				if (to === undefined) return;
				e.preventDefault();
				pin(Math.max(0, Math.min(pips.length - 1, to)), true);
			});
		});
		// The rows below work the same way: hover to look, click to keep it
		rows.forEach((r) => {
			const lvl = +r.dataset.level!;
			r.addEventListener('pointerenter', (e) => e.pointerType !== 'touch' && show(lvl));
			r.addEventListener('pointerleave', (e) => e.pointerType !== 'touch' && show(pinned));
			r.addEventListener('click', () => pin(lvl));
		});
		show(0);
	}
</script>

<style>
	/* The view with the level picker beside it, the list of levels underneath */
	.vb-tipsy {
		display: grid;
		grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
		grid-template-areas: 'view levels' 'list list';
		gap: 20px 24px;
		align-items: start;
		margin: 28px 0;
	}
	.view-wrap {
		grid-area: view;
	}
	.levels {
		grid-area: levels;
		display: grid;
		grid-template-columns: repeat(auto-fill, 48px);
		gap: 10px;
		align-content: start;
	}
	.levels::after {
		content: attr(data-hint);
		grid-column: 1 / -1;
		color: var(--sl-color-gray-3);
		line-height: 28px;
	}
	@media (hover: none) {
		.levels::after {
			content: attr(data-hint-touch);
		}
	}
	.fd-tipsy {
		grid-area: list;
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 4px;
	}
	/* The view: a window into the game */
	.view {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-style: solid;
		border-width: 12px 16px 16px 12px;
		border-image: url('../../assets/ui/board.png') 3 4 4 3 / 12px 16px 16px 12px repeat;
		image-rendering: pixelated;
		background: #000;
	}
	.world {
		position: absolute;
		inset: -8%;
		transform-origin: 50% 60%;
	}
	/* Double vision: a second, faint image slides apart and back (the game's split is a share of the screen's width) */
	.ghost {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.f-double .ghost {
		opacity: 0.35;
		translate: calc(var(--split, 0) * 150%) 0;
		animation: double 5s ease-in-out infinite;
	}
	@keyframes double {
		0%,
		100% {
			translate: calc(var(--split, 0) * 30%) 0;
		}
		50% {
			translate: calc(var(--split, 0) * 150%) calc(var(--split, 0) * 25%);
		}
	}
	/* Drunk eyes: soft, slightly warm screen edges */
	.edges {
		position: absolute;
		inset: 0;
		pointer-events: none;
		backdrop-filter: blur(calc(var(--soft, 0) * 5px));
		background: radial-gradient(ellipse at center, transparent 50%, rgb(255 170 90 / calc(var(--soft, 0) * 0.3)) 100%);
		-webkit-mask-image: radial-gradient(ellipse at center, transparent 45%, #000 90%);
		mask-image: radial-gradient(ellipse at center, transparent 45%, #000 90%);
		transition: backdrop-filter 0.3s;
	}
	.world :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		image-rendering: auto;
		display: block;
	}
	/* Stumble: a sudden lurch sideways */
	.f-stumble .shot,
	.f-stumble :global(.shot) {
		animation: stumble 4.3s ease-in-out infinite;
	}
	@keyframes stumble {
		0%,
		80%,
		100% {
			transform: none;
		}
		86% {
			transform: translateX(5%) rotate(2deg);
		}
	}
	/* Hiccups: a sharp little jolt of the view and a *hic* */
	.f-hic .world {
		animation: jolt 2.6s ease-out infinite;
	}
	@keyframes jolt {
		0%,
		89%,
		100% {
			translate: 0 0;
		}
		90% {
			translate: 0 1.6%;
		}
	}
	.hic-txt {
		position: absolute;
		right: 14%;
		top: 24%;
		color: #fff;
		text-shadow: 2px 2px 0 #3f3f3f;
		opacity: 0;
		pointer-events: none;
	}
	.f-hic .hic-txt {
		animation: hic 2.6s ease-out infinite;
	}
	@keyframes hic {
		0%,
		86% {
			opacity: 0;
			transform: translateY(6px);
		}
		90% {
			opacity: 1;
			transform: none;
		}
		100% {
			opacity: 0;
			transform: translateY(-12px);
		}
	}
	/* The effect icons, top right, like the game's HUD */
	.hud {
		position: absolute;
		top: 8px;
		right: 8px;
		display: flex;
		gap: 4px;
	}
	.eff {
		position: relative;
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		background: rgb(0 0 0 / 0.45);
		box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.35);
	}
	.eff[hidden] {
		display: none;
	}
	.eff img {
		image-rendering: pixelated;
	}
	.eff b {
		position: absolute;
		right: 2px;
		bottom: -2px;
		font-weight: 400;
		font-size: 20px;
		color: #fff;
		text-shadow: 2px 2px 0 #3f3f3f;
	}
	/* Chat, bottom left */
	.chat {
		position: absolute;
		left: 8px;
		bottom: 8px;
		margin: 0;
		padding: 0 6px;
		max-width: calc(100% - 16px);
		background: rgb(0 0 0 / 0.5);
		color: #fff;
		text-shadow: 2px 2px 0 #3f3f3f;
		line-height: 28px;
	}
	.view-cap {
		margin-top: 6px;
	}
	.lvl-name {
		color: var(--sl-color-text-accent);
	}
	/* The level picker: one square per level, sober to the top */
	.pip {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		font: inherit;
		font-size: 20px;
		color: #fff;
		text-shadow: 2px 2px 0 #000;
		border: 0;
		cursor: pointer;
		background: color-mix(in srgb, #a8283f calc((var(--lvl) - 1) * 25%), #e8a23c);
		box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.3), inset -2px -2px 0 rgb(0 0 0 / 0.3), 0 0 0 2px #000;
		transition: transform 0.12s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.pip[data-level='0'] {
		background: #5f8f3a;
	}
	.pip:hover,
	.pip:focus-visible {
		transform: translateY(-3px);
		outline: none;
	}
	.pip[aria-checked='true'] {
		box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.3), inset -2px -2px 0 rgb(0 0 0 / 0.3), 0 0 0 2px #000, 0 0 0 5px var(--vb-gilt);
		transform: translateY(-3px);
	}
	/* The rows */
	li {
		display: flex;
		gap: 14px;
		align-items: center;
		margin: 0 !important;
		padding: 4px 8px 4px 4px;
		font-size: 20px;
		line-height: 30px;
		cursor: pointer;
		transition: background-color 0.12s;
	}
	li:hover,
	li.on {
		background: var(--fd-surface-2);
		box-shadow: inset 4px 0 0 var(--sl-color-text-accent);
	}
	/* One row's additions, separated by a dot */
	.add + .add::before {
		content: ' · ';
		color: var(--sl-color-gray-3);
	}
	.lvl {
		flex: none;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		color: #fff;
		text-shadow: 2px 2px 0 #000;
		background: color-mix(in srgb, #a8283f calc((var(--lvl) - 1) * 25%), #e8a23c);
		box-shadow: inset 2px 2px 0 rgb(255 255 255 / 0.3), inset -2px -2px 0 rgb(0 0 0 / 0.3);
	}
	@media (max-width: 40rem) {
		.vb-tipsy {
			grid-template-columns: 1fr;
			grid-template-areas: 'view' 'levels' 'list';
		}
		.levels {
			grid-template-columns: repeat(6, 1fr);
		}
		.pip {
			width: auto;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.view *,
		.view {
			animation: none !important;
		}
	}
</style>
