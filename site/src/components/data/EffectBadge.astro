---
// A status effect with its real icon and duration.
import { url, pageUrl, duration, roman, gameText } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
interface Props {
	id: string;
	name?: string;
	ticks?: number;
	amplifier?: number;
	note?: string;
}
const { id, name, ticks, amplifier = 0, note } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const [ns, p] = id.split(':');
// Effect icons copied by scripts/copy-gui.mjs
const AVAILABLE = new Set(['tipsy', 'regeneration', 'speed', 'haste', 'saturation', 'absorption', 'fire_resistance', 'slowness', 'mining_fatigue', 'nausea']);
const icon = AVAILABLE.has(p) ? url(`/gui/effect/${p}.png`) : null;
const label = gameText(`effect.${ns}.${p}`, name ?? p.replaceAll('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase()), locale);
// The mod's own effect links to its page (except on that page); vanilla effects are plain badges
const own = id.startsWith('vineandbarrel:');
const href = own && p === 'tipsy' && !Astro.url.pathname.endsWith('/tipsy/') ? pageUrl('/tipsy/', locale) : null;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['fd-effect', { own }]} href={href ?? undefined}>
	{icon && <img src={icon} alt="" width="18" height="18" />}
	<span class="name">{label}{amplifier > 0 ? ` ${roman(amplifier)}` : ''}</span>
	{ticks ? <span class="dur">{p === 'saturation' ? t('{n} food points', locale, { n: ticks * (amplifier + 1) }) : duration(ticks, locale)}</span> : null}
	{note ? <span class="dur">{note}</span> : null}
</Tag>
<style>
	.fd-effect {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.1rem 0.45rem 0.1rem 0.25rem;
		border: 1px solid var(--fd-border);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		white-space: nowrap;
		line-height: 1.4;
	}
	.own {
		border-color: var(--vb-gilt-dark);
	}
	a.fd-effect {
		text-decoration: none;
		transition: border-color 0.1s, background-color 0.1s;
	}
	a.fd-effect:hover,
	a.fd-effect:focus-visible {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		outline: none;
	}
	img {
		image-rendering: pixelated;
	}
	.dur {
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}
</style>
