---
// Hunger shanks (from the vanilla HUD sprites) plus a saturation gauge, for one food.
import { url } from '../../lib/data';
interface Props {
	nutrition: number;
	saturation: number;
	compact?: boolean;
}
const { nutrition, saturation, compact = false } = Astro.props;
const full = Math.floor(nutrition / 2);
const half = nutrition % 2;
const icons = [...Array(full).fill('food_full'), ...Array(half).fill('food_half')];
const satPct = Math.min(100, (saturation / 20) * 100);
---
<div class:list={['fd-food', 'not-content', { compact }]}>
	<div class="shanks" role="img" aria-label={`${nutrition} hunger points`} title={`${nutrition} hunger points (${nutrition / 2} shanks)`}>
		{icons.map((i) => <img src={url(`/gui/mc/${i}.png`)} alt="" width="18" height="18" />)}
		<span class="n">{nutrition} <small>hunger</small></span>
	</div>
	<div class="sat" title={`${+saturation.toFixed(2)} saturation (maximum 20)`}>
		<span class="bar"><span style={`width:${satPct}%`}></span></span>
		<span class="n">{+saturation.toFixed(2)} <small>saturation</small></span>
	</div>
</div>
<style>
	.fd-food {
		display: inline-grid;
		gap: 0.3rem;
	}
	.shanks,
	.sat {
		display: flex;
		align-items: center;
		gap: 1px;
		flex-wrap: wrap;
	}
	.shanks img {
		image-rendering: pixelated;
		width: 18px;
		height: 18px;
	}
	.compact .shanks img {
		width: 14px;
		height: 14px;
	}
	.n {
		margin-left: 0.5rem;
		font-family: var(--fd-font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}
	.n small {
		color: var(--sl-color-gray-3);
		font-size: 0.85em;
	}
	.bar {
		width: 9rem;
		height: 0.55rem;
		border: 1px solid var(--fd-gold);
	}
	.compact .bar {
		width: 5rem;
	}
	.bar span {
		display: block;
		height: 100%;
		background: var(--fd-gold);
	}
</style>
