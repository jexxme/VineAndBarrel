---
// Village farms, trades and chest loot, from the mod's data (runtime.json and the generated loot tables and trades).
import Slot from '../mc/Slot.astro';
import Item from '../mc/Item.astro';
import { rules, trades, loot, nameOf, gameText, pct, num, list } from '../../lib/data';
import { t, localeOf } from '../../lib/i18n';
interface Props {
	show: 'farms' | 'trades' | 'keeper' | 'loot';
}
const { show } = Astro.props;
const locale = localeOf(Astro.currentLocale);
// The rules roll in order, each on what is still wheat: a crop's share of the farm is its chance times what the earlier
// rules left (plains: barley 10%, then grapes 5% of the remaining 90% = 4.5%, then hops 5% of 85.5% = 4.275%)
const farms = Object.entries(rules.villages.farmCrops as Record<string, { block: string; chance: number }[]>).map(([type, crops]) => {
	let left = 1;
	return [type, crops.map((c) => {
		const share = c.chance * left;
		left -= share;
		return { ...c, share };
	})] as [string, { block: string; chance: number; share: number }[]];
});
const VILLAGE: Record<string, () => string> = {
	desert: () => t('Desert', locale),
	plains: () => t('Plains', locale),
	savanna: () => t('Savanna', locale),
	snowy: () => t('Snowy', locale),
	taiga: () => t('Taiga', locale),
};
const villageName = (s: string) => (VILLAGE[s] ? VILLAGE[s]() : s);
// A village type from a loot table's name: village/tavern_plains, village/tavern_cellar_plains, village/village_plains_house
const villageOf = (k: string) => k.split('/').pop()!.split('_').find((p) => VILLAGE[p]) ?? k;
const cropItem: Record<string, string> = { 'vineandbarrel:grape_bush': 'vineandbarrel:red_grapes', 'vineandbarrel:hop_bush': 'vineandbarrel:hops', 'vineandbarrel:barley': 'vineandbarrel:barley' };
const tables = Object.keys(loot) as string[];
const bar = tables.filter((k) => k.includes('tavern_') && !k.includes('tavern_cellar_'));
const cellar = tables.filter((k) => k.includes('tavern_cellar_'));
const house = tables.filter((k) => k.includes('house'));
const lootRows = (keys: string[]) => keys.map((k) => ({ type: villageName(villageOf(k)), pools: loot[k] }));
// Farmers and the wandering trader in one table; the tavern keeper gets his own, by level
const others = trades.filter((tr) => tr.profession !== 'tavern_keeper');
const keeper = trades.filter((tr) => tr.profession === 'tavern_keeper');
const keeperLevels = [...new Set(keeper.map((tr) => tr.level as number))].sort((a, b) => a - b).map((level) => ({
	level,
	name: gameText(`merchant.level.${level}`, keeper.find((tr) => tr.level === level)?.levelName ?? String(level), locale),
	trades: keeper.filter((tr) => tr.level === level),
}));
const offers = [...new Set(keeper.map((tr) => tr.offers).filter((n) => n != null))];
// Where a regional trade is offered: the village type's name, else the biome's (swamp, jungle)
const regionName = (v: { id: string; key: string; name: string }) => {
	const village = v.id === 'snow' ? 'snowy' : v.id;
	return VILLAGE[village] ? VILLAGE[village]() : gameText(v.key, v.name, locale);
};
---
{
	show === 'farms' && (
		<table class="not-content">
			<thead><tr><th>{t('Village', locale)}</th><th>{t("Share of the farm's wheat that becomes", locale)}</th></tr></thead>
			<tbody>
				{farms.map(([type, crops]) => (
					<tr>
						<td>{villageName(type)}</td>
						<td>{crops.map((c, i) => <>{i > 0 && ', '}<Item id={cropItem[c.block] ?? c.block} label={nameOf(c.block, locale)} /> {pct(c.share, 1, locale)}</>)}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
{
	show === 'trades' && (
		<table class="not-content">
			<thead><tr><th>{t('Who', locale)}</th><th>{t('Gives', locale)}</th><th>{t('For', locale)}</th><th>{t('Uses', locale)}</th></tr></thead>
			<tbody>
				{others.map((tr) => (
					<tr>
						<td>{tr.profession === 'farmer' ? t('Farmer (level {level})', locale, { level: tr.level }) : t('Wandering trader', locale)}</td>
						<td><Slot id={tr.gives.id} count={tr.gives.count} /></td>
						<td><Slot id={tr.wants.id} count={tr.wants.count} /></td>
						<td>{num(tr.maxUses, locale)}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
{
	show === 'keeper' && (
		<>
			<table class="not-content">
				<thead><tr><th>{t('Level', locale)}</th><th>{t('Gives', locale)}</th><th>{t('For', locale)}</th><th>{t('Only in', locale)}</th><th>{t('Uses', locale)}</th></tr></thead>
				<tbody>
					{keeperLevels.map((lv) => lv.trades.map((tr, i) => (
						<tr class:list={{ first: i === 0 }}>
							{i === 0 && <td rowspan={lv.trades.length} class="level">{lv.name}</td>}
							{tr.sealed ? (
								<td class="slots">
									<Slot id={tr.gives.id} count={tr.gives.count} note={t('Sealed, full of {drink} ({n} servings)', locale, { drink: nameOf(tr.sealed.drink, locale), n: tr.sealed.servings })} />
									<span class="sealed">{t('full of', locale)}</span>
									<Slot id={tr.sealed.drink} count={tr.sealed.servings} note={t('Sealed, full of {drink} ({n} servings)', locale, { drink: nameOf(tr.sealed.drink, locale), n: tr.sealed.servings })} />
								</td>
							) : <td><Slot id={tr.gives.id} count={tr.gives.count} /></td>}
							<td><Slot id={tr.wants.id} count={tr.wants.count} /></td>
							<td>{tr.variants ? list(tr.variants.map(regionName), locale) : t('Everywhere', locale)}</td>
							<td>{num(tr.maxUses, locale)}</td>
						</tr>
					)))}
				</tbody>
			</table>
			{offers.length === 1 && <p class="note">{t('At each level he offers {n} of the trades listed for it, picked at random.', locale, { n: offers[0] as number })}</p>}
		</>
	)
}
{
	show === 'loot' && (
		<>
			{[[t('Tavern bar chests', locale), bar], [t('Tavern cellar chests', locale), cellar], [t('Village house chests', locale), house]].map(([title, keys]) => (
				<>
					<h3>{title}</h3>
					<table class="not-content">
						<thead><tr><th>{t('Village', locale)}</th><th>{t('What can be in it', locale)}</th></tr></thead>
						<tbody>
							{lootRows(keys as string[]).map((r) => (
								<tr>
									<td>{r.type}</td>
									<td class="slots">
										{r.pools.flatMap((p) => p.entries).map((e) => e.table ? (
											<span class="draw">{t('One draw from a {village} house chest', locale, { village: villageName(villageOf(e.table)) })}</span>
										) : (
											<Slot id={e.id} count={e.count[1]} note={t('{count} · {pct} of the picks', locale, { count: e.count[0] === e.count[1] ? num(e.count[0], locale) : t('{min} to {max}', locale, { min: e.count[0], max: e.count[1] }), pct: pct(e.chance, 0, locale) })} />
										))}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			))}
		</>
	)
}
<style>
	table {
		border-collapse: collapse;
		width: 100%;
		font-size: 20px;
		margin: 1rem 0;
	}
	th {
		text-align: left;
		color: var(--fd-heading-ink);
		font-weight: 400;
		border-bottom: 2px solid var(--fd-rule);
		padding: 4px 10px;
	}
	td {
		padding: 6px 10px;
		border-bottom: 1px solid var(--fd-border);
		vertical-align: middle;
	}
	td.slots {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}
	td.level {
		color: var(--fd-heading-ink);
		white-space: nowrap;
	}
	tr.first td {
		border-top: 2px solid var(--fd-border);
	}
	td.slots .sealed {
		align-self: center;
		font-size: 18px;
	}
	.draw {
		align-self: center;
		padding: 0 8px;
		font-size: 18px;
		border: 1px dashed var(--fd-border);
	}
	p.note {
		font-size: 18px;
		margin-top: -0.5rem;
	}
	h3 {
		color: var(--fd-heading-ink);
		font-weight: 400;
		font-size: 20px;
		margin-top: 1.5rem;
	}
</style>
