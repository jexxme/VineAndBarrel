---
// Village farms, trades and chest loot, from the mod's data (runtime.json and the generated loot tables and trades).
import Slot from '../mc/Slot.astro';
import Item from '../mc/Item.astro';
import { rules, trades, loot, nameOf, pct } from '../../lib/data';
interface Props {
	show: 'farms' | 'trades' | 'loot';
}
const { show } = Astro.props;
// The rules roll in order, each on what is still wheat: a crop's share of the farm is its chance times what the earlier
// rules left (plains: barley 10%, then grapes 5% of the remaining 90% = 4.5%, then hops 5% of 85.5% = 4.275%)
const farms = Object.entries(rules.villages.farmCrops as Record<string, { block: string; chance: number }[]>).map(([type, crops]) => {
	let left = 1;
	return [type, crops.map((c) => {
		const share = c.chance * left;
		left -= share;
		return { ...c, share };
	})] as [string, { block: string; chance: number; share: number }[]];
});
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const cropItem: Record<string, string> = { 'vineandbarrel:grape_bush': 'vineandbarrel:red_grapes', 'vineandbarrel:hop_bush': 'vineandbarrel:hops', 'vineandbarrel:barley': 'vineandbarrel:barley' };
const tavern = (Object.keys(loot) as string[]).filter((k) => k.includes('tavern'));
const house = (Object.keys(loot) as string[]).filter((k) => k.includes('house'));
const lootRows = (keys: string[]) => keys.map((k) => ({ type: cap(k.split('_')[1]), pools: loot[k] }));
---
{
	show === 'farms' && (
		<table class="not-content">
			<thead><tr><th>Village</th><th>Share of the farm's wheat that becomes</th></tr></thead>
			<tbody>
				{farms.map(([type, crops]) => (
					<tr>
						<td>{cap(type)}</td>
						<td>{crops.map((c, i) => <>{i > 0 && ', '}<Item id={cropItem[c.block] ?? c.block} label={nameOf(c.block)} /> {pct(c.share, 1)}</>)}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
{
	show === 'trades' && (
		<table class="not-content">
			<thead><tr><th>Who</th><th>Gives</th><th>For</th><th>Uses</th></tr></thead>
			<tbody>
				{trades.map((t) => (
					<tr>
						<td>{t.profession === 'farmer' ? `Farmer (level ${t.level})` : 'Wandering trader'}</td>
						<td><Slot id={t.gives.id} count={t.gives.count} /></td>
						<td><Slot id={t.wants.id} count={t.wants.count} /></td>
						<td>{t.maxUses}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
{
	show === 'loot' && (
		<>
			{[['Tavern chests', tavern], ['Village house chests', house]].map(([title, keys]) => (
				<>
					<h3>{title}</h3>
					<table class="not-content">
						<thead><tr><th>Village</th><th>What can be in it</th></tr></thead>
						<tbody>
							{lootRows(keys as string[]).map((r) => (
								<tr>
									<td>{r.type}</td>
									<td class="slots">
										{r.pools.flatMap((p) => p.entries).map((e) => (
											<Slot id={e.id} count={e.count[1]} note={`${e.count[0] === e.count[1] ? e.count[0] : `${e.count[0]} to ${e.count[1]}`} · ${pct(e.chance)} of the picks`} />
										))}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			))}
		</>
	)
}
<style>
	table {
		border-collapse: collapse;
		width: 100%;
		font-size: 20px;
		margin: 1rem 0;
	}
	th {
		text-align: left;
		color: var(--fd-heading-ink);
		font-weight: 400;
		border-bottom: 2px solid var(--fd-rule);
		padding: 4px 10px;
	}
	td {
		padding: 6px 10px;
		border-bottom: 1px solid var(--fd-border);
		vertical-align: middle;
	}
	td.slots {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}
	h3 {
		color: var(--fd-heading-ink);
		font-weight: 400;
		font-size: 20px;
		margin-top: 1.5rem;
	}
</style>
